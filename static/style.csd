*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#202b40;font:14px Arial,sans-serif}button{border:0;background:#3869df;color:white;padding:10px 15px;border-radius:8px;font-weight:bold;cursor:pointer}input,textarea,select{width:100%;padding:11px;border:1px solid #dfe5ef;border-radius:8px;margin:7px 0 14px;background:#fff;color:#202b40}textarea{min-height:120px}aside{position:fixed;inset:0 auto 0 0;width:230px;background:#fff;border-right:1px solid #e7ebf2;padding:25px 16px;display:flex;flex-direction:column;gap:9px}.brand{font-size:18px;font-weight:bold;margin:0 0 35px}.brand b,.logo{background:#eaf0ff;color:#3869df;padding:10px;border-radius:10px;margin-right:8px}aside small,header small,.loginbox small{color:#929bad;letter-spacing:1px;font-size:10px}aside button{background:transparent;color:#536078;text-align:left}aside button:hover{background:#edf2ff;color:#3869df}.logout{margin-top:auto;color:#b14b52}main{margin-left:230px;padding:0 34px 50px}header{height:95px;border-bottom:1px solid #e5eaf1;display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}h1{font-size:25px;margin:7px 0}h2{font-size:21px}.admin{background:white;border:1px solid #e5eaf1;padding:10px 14px;border-radius:30px}.hero,.card,.stats article{background:white;border:1px solid #e5eaf1;border-radius:13px;padding:22px;margin-bottom:18px}.hero{background:linear-gradient(110deg,#fff,#eef3ff)}.hero h2{margin:0}.hero p,.row p{color:#8791a3}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.stats article{margin:0;color:#7b8597}.stats strong{display:block;color:#202b40;font-size:27px;margin-top:10px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 0 18px}.row input{max-width:350px}.secondary{background:#edf1f7;color:#45536b}.view.hidden{display:none}.form{max-width:650px}.form label{display:block;font-weight:bold;font-size:12px}.notice{background:#fff7e8;padding:12px;color:#946a18;border-radius:8px}table{width:100%;border-collapse:collapse;font-size:12px;min-width:600px}td,th{padding:12px;border-bottom:1px solid #edf0f4;text-align:left}th{color:#8b95a6}.scroll{overflow:auto}.status{border-radius:20px;background:#f1f3f7;padding:5px 8px}.login{min-height:100vh;display:grid;place-items:center;background:#eef3ff}.loginbox{background:#fff;padding:36px;border:1px solid #e5eaf1;border-radius:17px;width:min(400px,92vw);display:flex;flex-direction:column;gap:9px}.loginbox h1{margin:8px 0}.loginbox p,.foot{color:#8993a5}.loginbox label{font-size:12px;font-weight:bold}.loginbox button{margin-top:10px}.err{color:#bd3944}@media(max-width:750px){aside{width:65px;padding:15px 6px}.brand{font-size:0}.brand b{font-size:13px}aside small{display:none}aside button{font-size:0;text-align:center;padding:13px 2px}aside button:first-letter{font-size:16px}main{margin-left:65px;padding:0 12px}.stats{grid-template-columns:repeat(2,1fr)}.admin{display:none}}
